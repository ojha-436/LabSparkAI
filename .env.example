# Copy to .env.local for the frontend (Vite). All values are optional.

# Base URL of the Gemini backend (server/). Local default shown.
# After deploying to Cloud Run, set this to the Cloud Run service URL.
VITE_API_BASE=http://localhost:8787

# Optional Firebase web-config overrides (defaults are baked in firebaseInit.js).
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
