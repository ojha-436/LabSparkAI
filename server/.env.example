# Copy to server/.env and fill in. NEVER commit the real .env.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
PORT=8787

# ══ Agora Conversational AI (live Spark voice) ══════════════════════════
# All of these are SERVER-ONLY. The Android app receives just the App ID,
# passed at build time with --dart-define=AGORA_APP_ID=…
#
# Console → Projects → <your project> → Project Details
#   "App ID"           → copy directly
#   "App Certificate"  → must be ENABLED; click the eye icon to reveal
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Console → Developer Toolkit → RESTful API → "Add a secret"
# Downloads key_and_secret.txt — the secret is shown ONCE ONLY.
# Authenticates the server-to-server ConvoAI calls (HTTP Basic).
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# ── Optional. Left blank, ASR and TTS run in MANAGED mode and Agora
#    supplies the provider credentials — no Deepgram/MiniMax account. ──
# AGORA_ASR_VENDOR=deepgram
# AGORA_ASR_LANGUAGE=en-IN
# AGORA_TTS_VENDOR=minimax
# AGORA_TTS_MODEL=speech-2.6-turbo
# AGORA_TTS_VOICE=English_captivating_female1
# AGORA_LLM_MODEL=gemini-2.5-flash
# AGORA_IDLE_TIMEOUT=60
# AGORA_TOKEN_TTL=3600
