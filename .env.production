# Production env for the Android/PWA app site (labspark-app.web.app).
# authDomain MUST match the app's own hosting domain so signInWithRedirect is
# same-origin — otherwise the Google redirect result is dropped by browser
# storage partitioning and the user bounces back to the landing page.
VITE_API_BASE=https://labspark-backend-686718900098.asia-south1.run.app
VITE_FIREBASE_AUTH_DOMAIN=labspark-app.web.app
