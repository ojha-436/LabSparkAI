rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can read/write only their own account document (role, profile, links).
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Parent-readable progress mirror (written by the student) ──
    match /students/{studentUid} {
      allow read: if request.auth != null && (
        request.auth.uid == studentUid ||
        exists(/databases/$(database)/documents/students/$(studentUid)/guardians/$(request.auth.uid))
      );
      allow create, update: if request.auth != null && request.auth.uid == studentUid
        && request.resource.data.studentUid == studentUid;

      // A guardian links themselves by proving they know the student's family code.
      match /guardians/{parentUid} {
        allow read: if request.auth != null && (request.auth.uid == parentUid || request.auth.uid == studentUid);
        allow create: if request.auth != null && request.auth.uid == parentUid
          && get(/databases/$(database)/documents/familyCodes/$(request.resource.data.code)).data.studentUid == studentUid;
        allow delete: if request.auth != null && (request.auth.uid == parentUid || request.auth.uid == studentUid);
      }
    }

    // Family code lookup (CODE -> studentUid). Student owns it; any signed-in user can resolve a code.
    match /familyCodes/{code} {
      allow get: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.resource.data.studentUid == request.auth.uid;
    }

    // ── Classrooms ──  teacherUid is denormalised so teacher reads need no get().
    match /classes/{code} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && resource.data.teacherUid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.teacherUid == request.auth.uid;

      match /members/{studentUid} {
        allow read: if request.auth != null &&
          (request.auth.uid == studentUid || request.auth.uid == resource.data.teacherUid);
        allow create, update: if request.auth != null && request.auth.uid == studentUid &&
          request.resource.data.teacherUid == get(/databases/$(database)/documents/classes/$(code)).data.teacherUid;
        allow delete: if request.auth != null && request.auth.uid == studentUid;
      }

      match /submissions/{subId} {
        allow read: if request.auth != null &&
          (request.auth.uid == resource.data.studentUid || request.auth.uid == resource.data.teacherUid);
        allow create: if request.auth != null && request.resource.data.studentUid == request.auth.uid &&
          request.resource.data.teacherUid == get(/databases/$(database)/documents/classes/$(code)).data.teacherUid;
        allow update: if request.auth != null && (
          // The student re-doing their own lab (owns the record) — but may NEVER
          // touch the mark fields (those are the teacher's, enforced server-side).
          (request.resource.data.studentUid == request.auth.uid &&
           request.resource.data.teacherUid == get(/databases/$(database)/documents/classes/$(code)).data.teacherUid &&
           !request.resource.data.diff(resource.data).affectedKeys().hasAny(['teacherMark', 'marksApproved', 'gradedBy', 'gradedAt'])) ||
          // The class teacher grading: ONLY the mark fields may change.
          (request.auth.uid == resource.data.teacherUid &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teacherMark', 'marksApproved', 'gradedBy', 'gradedAt']))
        );
        allow delete: if false;
      }

      // ── Assignments — teacher assigns labs to the class; any member reads them. ──
      match /assignments/{labId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null &&
          get(/databases/$(database)/documents/classes/$(code)).data.teacherUid == request.auth.uid;
      }

      // ── Live session (singleton) — teacher runs one lab for the whole class. ──
      match /live/{docId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null &&
          get(/databases/$(database)/documents/classes/$(code)).data.teacherUid == request.auth.uid;
      }

      // ── Pre-roster (expected students) — teacher only. Reads are gated to the
      //    class teacher so classmates' names/roll numbers aren't exposed to
      //    anyone who merely has the (shared) class code. ──
      match /roster/{docId} {
        allow read: if request.auth != null && resource.data.teacherUid == request.auth.uid;
        allow write: if request.auth != null &&
          get(/databases/$(database)/documents/classes/$(code)).data.teacherUid == request.auth.uid;
      }

      // ── Presence heartbeats — student writes own; teacher reads (teacherUid-filtered). ──
      match /presence/{studentUid} {
        allow read: if request.auth != null && request.auth.uid == resource.data.teacherUid;
        allow create, update: if request.auth != null && request.auth.uid == studentUid &&
          request.resource.data.teacherUid == get(/databases/$(database)/documents/classes/$(code)).data.teacherUid;
        allow delete: if request.auth != null && request.auth.uid == studentUid;
      }

      // Class stream: announcements (teacher) + posts (members). Code is the gate for reads.
      match /posts/{postId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.authorUid == request.auth.uid
          && (
            request.auth.uid == get(/databases/$(database)/documents/classes/$(code)).data.teacherUid ||
            exists(/databases/$(database)/documents/classes/$(code)/members/$(request.auth.uid))
          );
        allow delete: if request.auth != null && (
          request.auth.uid == resource.data.authorUid ||
          request.auth.uid == get(/databases/$(database)/documents/classes/$(code)).data.teacherUid
        );
      }
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
